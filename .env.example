# Root environment configuration template
# Copy to .env for local overrides. NEVER commit actual secrets to source control.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
DATABASE_URL=sqlite:///./coteacher_backend.db
# For PostgreSQL container:
# DATABASE_URL=postgresql://coteacher_user:coteacher_dev_password@localhost:5432/coteacher_db

PACKS_STORAGE_DIR=./data/packs/dist
ENABLE_TELEMETRY=false
