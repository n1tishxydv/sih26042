{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LanguagePackManifest",
  "description": "Canonical schema for SIH26042 Smart Language Pack (SLP) manifest.json",
  "type": "object",
  "required": [
    "pack_id",
    "pack_format_version",
    "schema_version",
    "language_code",
    "language_name",
    "native_name",
    "version",
    "min_app_version",
    "script",
    "checksums"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Unique identifier for the language pack"
    },
    "pack_format_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "schema_version": {
      "type": "string",
      "default": "1.1.0"
    },
    "language_code": {
      "type": "string",
      "pattern": "^[a-z]{3}$",
      "description": "ISO 639-3 three-letter language code (e.g. sat, unr, hoc)"
    },
    "language_name": {
      "type": "string",
      "description": "Standard English name of the language"
    },
    "native_name": {
      "type": "string",
      "description": "Language name in native mother tongue script"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic versioning string (e.g. 1.0.0)"
    },
    "min_app_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "max_app_version": {
      "type": ["string", "null"]
    },
    "description": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "default": "sat_IN"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "pack_size_bytes": {
      "type": "integer"
    },
    "checksum": {
      "type": "string",
      "description": "SHA-256 hash of the complete compiled .slp archive"
    },
    "validation_status": {
      "type": "string",
      "enum": ["VALIDATED", "PENDING", "EXPERIMENTAL", "DEPRECATED"],
      "default": "VALIDATED"
    },
    "script": {
      "type": "object",
      "required": ["primary_script_name", "iso_15924", "unicode_range_start", "unicode_range_end"],
      "properties": {
        "primary_script_name": { "type": "string" },
        "iso_15924": { "type": "string" },
        "unicode_range_start": { "type": "string" },
        "unicode_range_end": { "type": "string" },
        "transliteration_scripts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "font_file": { "type": ["string", "null"] },
        "font_family": { "type": "string" }
      }
    },
    "language_metadata": {
      "type": "object",
      "properties": {
        "iso_639_3": { "type": "string" },
        "bcp_47": { "type": "string" },
        "directionality": { "type": "string", "enum": ["ltr", "rtl"] },
        "unicode_ranges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supported_input_scripts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supported_output_scripts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transliteration_available": { "type": "boolean" }
      }
    },
    "model_config": {
      "type": ["object", "null"],
      "description": "Structured on-device AI model capabilities without fake promises"
    },
    "stats": {
      "type": "object",
      "properties": {
        "phrases_count": { "type": "integer" },
        "fln_vocab_count": { "type": "integer" },
        "worksheets_count": { "type": "integer" },
        "activities_count": { "type": "integer" },
        "audio_files_count": { "type": "integer" }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Deterministic map of relative file path to SHA-256 hex string"
    },
    "manifest_hash": {
      "type": ["string", "null"]
    }
  }
}
