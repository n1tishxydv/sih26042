# FastAPI Control Plane Configuration
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./coteacher_backend.db

# Storage directory where compiled .slp packages reside
PACKS_STORAGE_DIR=../../data/packs/dist

# Telemetry ingestion switch (Default disabled for privacy)
ENABLE_TELEMETRY=false
